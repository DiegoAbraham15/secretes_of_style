{
  "expo": {
    "name": "Secrets of Style",
    "slug": "secrets-of-style",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "secretsofstyle",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FCE7F3",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "single",
      "bundler": "metro",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "Secrets of Style usa tus fotos para registrar las prendas de tu armario.",
          "cameraPermission": "Secrets of Style usa la cámara para fotografiar tus prendas."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Secrets of Style usa tu ubicación para consultar el clima y recomendarte qué ponerte."
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#BE185D",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ]
    ]
  }
}
