# Copia este archivo como .env (no se sube al repositorio).

# MongoDB local (servicio de Windows). Con autenticación activada:
#   MONGO_URI=mongodb://app_secrets:<clave>@127.0.0.1:27017/secrets_of_style?authSource=secrets_of_style
# MongoDB Atlas (TLS incluido en mongodb+srv):
#   MONGO_URI=mongodb+srv://app_secrets:<clave>@<cluster>.mongodb.net/?retryWrites=true&w=majority&appName=secrets_of_style
MONGO_URI=mongodb://127.0.0.1:27017
MONGO_BD=secrets_of_style

# Clave que firma las sesiones. Si se omite, se usa backend/.clave_secreta (se crea sola).
# CLAVE_SECRETA=

# Búsqueda por imagen en Tiendas (la prenda exacta de la foto, con Google Cloud Vision). Clave de API de un
# proyecto de Google Cloud con la "Cloud Vision API" habilitada. Si se omite, se busca solo por texto.
# GOOGLE_VISION_CLAVE=
